# ── Copy to .env.local for local dev. Every variable the app or scripts read is listed here.
# ── Staging/prod: values come from Secret Manager via External Secrets (deploy/README.md).

# Platform (E1)
APP_ENV=local                          # local | staging | production (production hides quick-login, refuses seed)
APP_URL=http://localhost:3000          # public base URL; used in family links
GIT_SHA=dev                            # set by the image build; returned by /api/health
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=                     # handed to the login form at runtime (no NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=             # server only; bypasses RLS
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres   # seed, integration + concurrency tests
CLOCK_HMAC_SECRET=change-me-at-least-16-chars                          # contract C4
SEED_USER_PASSWORD=demo-password-123   # seeded staff users; also used by non-prod quick-login
E2E_FAMILY_CODE=                       # Playwright: code for 9876500040 from the seed output

# Guest (E2)
GUEST_COOKIE_SECRET=change-me-at-least-32-chars-long-xxxxx   # signs the family cookie set by /f/[key]

# Sarvam (E2): translation, TV speech and the PinkyBua assistant. Empty key = those features are off.
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
SARVAM_FORCE_FAIL=0                    # 1 = tts always throws (chime fallback drill)

# Flagsmith (E2). Empty FLAGSMITH_SERVER_KEY = flags use their safe fallbacks (no Flagsmith).
FLAGSMITH_SERVER_KEY=                  # server-side environment key ("ser.…")
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1
FLAGSMITH_ADMIN_KEY=                   # organisation API key, used only to turn voice_calls OFF after approval
FLAGSMITH_ADMIN_API_URL=https://api.flagsmith.com/api/v1
FLAGSMITH_ENVIRONMENT_KEY=             # the environment's (client) API key, used in Admin API paths
FLAG_OVERRIDE_ROLES=stage              # max two roles allowed to receive Flagsmith overrides ("stage_manager" = stage)

# Metrics + NudgeBee (E2)
METRICS_TOKEN=change-me                # Authorization: Bearer for GET /api/metrics
NUDGEBEE_WEBHOOK_SECRET=change-me      # HMAC-SHA256 of the raw body, header x-nudgebee-signature

# Job runner (Stage 3 E1). POST /api/jobs/tick with header X-Jobs-Token; prod: Helm CronJob every minute.
JOBS_TOKEN=change-me                   # ≥16 chars; empty/short = runner off (reminders/escalations paused)
# JOBS_NOW=2026-12-13T10:00:00Z         # local/staging only: pretend "now" for a tick (ignored in production)

# PinkyBua assistant (E2). Default provider: Sarvam chat (uses SARVAM_API_KEY above).
ASSISTANT_PROVIDER=sarvam               # sarvam | anthropic
SARVAM_CHAT_MODEL=sarvam-105b           # or sarvam-105b-conversations
# Only if ASSISTANT_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Photos (E3)
PHOTO_MATCH_WINDOW_MS=3000             # default ±window; per-wedding override in wedding.photo_match_window_ms
